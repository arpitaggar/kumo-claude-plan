// Copy this file to Secrets.xcconfig (gitignored) and fill in a real Google
// Maps API key from the Google Cloud Console. Restrict the key to this app's
// bundle ID before shipping — this file alone does not enforce that.
//
// Only needed to render the Google Maps route view; the free OpenStreetMap
// default works with no key at all.
GOOGLE_MAPS_API_KEY = YOUR_API_KEY_HERE
