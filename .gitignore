# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
**/**.env*
FIREBASE_TOKEN

# Build-time config passed via --dart-define-from-file (see
# lib/config/environment.dart / docs/SECURITY_AUDIT.md SEC-002). Real values
# live only in env.local.json on disk / CI secrets — never bundled as a
# Flutter asset. env.example.json is intentionally NOT ignored: it holds only
# placeholders and documents which keys are required.
env.local.json
env.*.json
!env.example.json

# Firebase platform config — contains a per-app API key. Not a traditional
# secret (Google's own guidance is that these are safe to ship in a client
# binary), but keeping it out of git avoids tripping secret scanners and
# keeps key rotation simple. Real files stay on disk locally / in CI secrets;
# see the checked-in *.example templates for the shape.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Google Maps API key — same rationale as above. Real key stays local/CI-only;
# see the *.example templates for the shape.
android/app/src/main/res/values/google_maps_api.xml
ios/Runner/Secrets.xcconfig
# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/
# ...except settings.json currently bakes in a machine-specific absolute path
# (cmake.sourceDirectory), so it's ignored until that's made portable.
.vscode/

# Per-workspace Flutter DevTools settings — local/personal, not shared.
devtools_options.yaml

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Per-platform Xcode build output (only appears once you've actually run a
# macOS build locally) — same rationale as /build/ above, just not covered
# by that root-anchored pattern.
macos/build/

# CocoaPods resolved dependency output (regenerated by `pod install` /
# `flutter build ios`) — introduced when google_maps_flutter pulled in
# google_maps_flutter_ios, which only supports CocoaPods, not this
# project's usual Swift Package Manager integration. Podfile and
# Podfile.lock are committed; this directory is not.
ios/Pods/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
