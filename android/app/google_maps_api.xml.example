<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to android/app/src/main/res/values/google_maps_api.xml
  (gitignored) and fill in a real Google Maps API key from the Google Cloud
  Console. Restrict the key to this app's package name + SHA-1 fingerprint
  before shipping — this file alone does not enforce that.

  Only needed to render the Google Maps route view; the free OpenStreetMap
  default works with no key at all.

  This template lives outside res/values/ deliberately — Android's resource
  merger scans every file in that directory and requires it to end in
  .xml, so a "*.xml.example" placeholder sitting there breaks the build
  (`Resource and asset merger: The file name must end with .xml`).
-->
<resources>
    <string name="google_maps_key" translatable="false">YOUR_API_KEY_HERE</string>
</resources>
